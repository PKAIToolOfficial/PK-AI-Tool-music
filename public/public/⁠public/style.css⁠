:root {
  --bg-page: #f4fbf7;
  --bg-card: #ffffff;
  --bg-subtle: #eaf7ef;
  --border-soft: #d2e8dc;
  --text-main: #0f2419;
  --text-muted: #4b6758;
  --green-main: #16a34a;
  --green-dark: #15803d;
  --green-bright: #22c55e;
  --blue-accent: #0284c7;
  --amber-accent: #d97706;
  --red-accent: #dc2626;
}

* {
  box-sizing: border-box;
}

body.studio-body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg-page);
  color: var(--text-main);
  padding-bottom: 84px;
}

.studio-shell {
  display: grid;
  grid-template-columns: 268px 1fr;
  min-height: 100vh;
}

.studio-sidebar {
  background: #ffffff;
  border-right: 1px solid var(--border-soft);
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.logo-lockup {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pk-logo-svg {
  flex-shrink: 0;
  box-shadow: 0 6px 16px rgba(22, 163, 74, 0.25);
  border-radius: 12px;
}

.brand-title {
  font-weight: 800;
  font-size: 16px;
  color: var(--text-main);
}

.brand-sub {
  font-size: 11px;
  color: var(--text-muted);
}

.studio-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.nav-pill {
  text-align: left;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-main);
  padding: 10px 12px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
}

.nav-pill:hover {
  background: var(--bg-subtle);
}

.nav-pill.active {
  background: linear-gradient(90deg, #16a34a, #0ea5e9);
  color: #ffffff;
}

.credit-card,
.ad-card {
  background: var(--bg-subtle);
  border: 1px solid var(--border-soft);
  border-radius: 12px;
  padding: 12px;
}

.credit-row {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  margin-bottom: 8px;
}

.meter-bg {
  height: 8px;
  background: #cde5d7;
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 6px;
}

.meter-fill {
  height: 100%;
  background: linear-gradient(90deg, #16a34a, #22c55e, #0284c7);
}

.tag-amber {
  display: inline-block;
  background: #fef3c7;
  color: #92400e;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 999px;
  margin-bottom: 6px;
}

.ad-card p {
  margin: 4px 0 10px;
  font-size: 12px;
  color: var(--text-muted);
}

.auth-mini-box {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-muted);
  padding: 8px 10px;
  border-radius: 10px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.dot-emerald {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green-main);
  flex-shrink: 0;
}

.studio-main {
  padding: 22px 24px;
}

.studio-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.studio-header h1 {
  margin: 0;
  font-size: 22px;
}

.studio-header p {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--text-muted);
}

.header-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.badge-green {
  background: #dcfce7;
  color: #166534;
  border: 1px solid #86efac;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.alert-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  background: #fffbeb;
  border: 1px solid #fcd34d;
  color: #78350f;
  padding: 12px 16px;
  border-radius: 12px;
  margin-bottom: 16px;
  font-size: 13px;
}

.alert-banner.hidden {
  display: none;
}

.banner-actions {
  display: flex;
  gap: 8px;
}

.view-panel {
  display: none;
}

.view-panel.active {
  display: block;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.card-surface {
  background: var(--bg-card);
  border: 1px solid var(--border-soft);
  border-radius: 14px;
  padding: 18px;
  box-shadow: 0 4px 14px rgba(15, 36, 25, 0.04);
}

.card-surface h3 {
  margin: 0 0 8px;
  font-size: 17px;
}

.toolbar-row,
.label-split {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.section-label {
  font-weight: 700;
  font-size: 14px;
}

.toggle-group {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.check-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-subtle);
  border: 1px solid var(--border-soft);
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.form-field {
  margin-bottom: 14px;
}

.form-field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
}

.form-field input[type="text"],
.form-field select,
.form-field textarea,
.chat-bar input {
  width: 100%;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: var(--text-main);
  font-size: 14px;
  font-family: inherit;
}

.form-field input[type="range"],
.player-bar-controls input[type="range"] {
  width: 100%;
  accent-color: var(--green-main);
}

.hint-text {
  display: block;
  color: var(--text-muted);
  font-size: 12px;
  margin-top: 4px;
}

.text-emerald,
.link-emerald {
  color: var(--green-dark);
  font-weight: 700;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 12px;
  padding: 0;
}

.btn-primary-full {
  width: 100%;
  padding: 12px 16px;
  border: none;
  border-radius: 11px;
  background: linear-gradient(90deg, #16a34a, #0ea5e9);
  color: #ffffff;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
}

.btn-green-sm,
.btn-outline-green,
.btn-soft {
  padding: 7px 12px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.btn-green-sm {
  background: var(--green-main);
  color: #ffffff;
  border: none;
}

.btn-outline-green {
  width: 100%;
  background: #ffffff;
  color: var(--green-dark);
  border: 1px solid var(--green-main);
}

.btn-soft {
  background: var(--bg-subtle);
  color: var(--text-main);
  border: 1px solid var(--border-soft);
}

.status-note {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 10px;
  min-height: 18px;
}

.tracks-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.track-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 12px;
  border-radius: 11px;
  background: #f8fcf9;
  border: 1px solid var(--border-soft);
}

.chat-feed {
  max-height: 320px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  border-radius: 11px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  margin-bottom: 12px;
}

.chat-msg {
  padding: 10px 12px;
  border-radius: 10px;
  font-size: 13px;
  white-space: pre-wrap;
}

.chat-msg.bot {
  background: #dcfce7;
  color: #14532d;
}

.chat-msg.user {
  background: #e0f2fe;
  color: #0c4a6e;
  align-self: flex-end;
}

.chat-bar {
  display: flex;
  gap: 8px;
}

.wallet-box {
  background: #f8fcf9;
  border: 1px solid var(--border-soft);
  border-radius: 10px;
  padding: 12px;
  font-size: 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  word-break: break-all;
}

.auth-tabs {
  display: flex;
  gap: 8px;
}

.auth-tab {
  flex: 1;
  padding: 8px 10px;
  border-radius: 9px;
  border: 1px solid var(--border-soft);
  background: var(--bg-subtle);
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}

.auth-tab.active {
  background: var(--green-main);
  color: #ffffff;
  border-color: var(--green-main);
}

.info-list {
  padding-left: 18px;
  margin: 8px 0 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  color: var(--text-muted);
}

.env-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 10px;
}

.status-card {
  border: 1px solid var(--border-soft);
  border-radius: 10px;
  padding: 10px;
  background: #f8fcf9;
  font-size: 13px;
}

.status-ok {
  color: var(--green-dark);
  font-weight: 700;
  margin-top: 4px;
}

.status-missing {
  color: var(--red-accent);
  font-weight: 700;
  margin-top: 4px;
}

.studio-player {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2px solid var(--green-main);
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  z-index: 50;
}

.player-meta {
  display: flex;
  flex-direction: column;
  min-width: 180px;
}

.player-bar-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  max-width: 520px;
}

.mt-12 {
  margin-top: 12px;
}

.mt-16 {
  margin-top: 16px;
}

@media (max-width: 860px) {
  .studio-shell {
    grid-template-columns: 1fr;
  }

  .two-col {
    grid-template-columns: 1fr;
  }

  .studio-player {
    flex-direction: column;
    align-items: stretch;
  }
}
