:root {
  --bg-page: #f5fbf7;
  --bg-surface: #ffffff;
  --bg-soft-green: #eaf8ef;
  --bg-soft-purple: #f3ecff;
  --border-light: #d3eadc;
  --border-purple: #ddd0ff;
  --text-dark: #0f2419;
  --text-muted: #4b6758;

  --green: #16a34a;
  --green-bright: #22c55e;
  --green-dark: #15803d;
  --purple: #7c3aed;
  --purple-dark: #5b21b6;
  --blue: #0284c7;
  --amber: #d97706;
  --rose: #e11d48;

  --brand-gradient: linear-gradient(135deg, #16a34a 0%, #7c3aed 55%, #0284c7 100%);
  --cta-gradient: linear-gradient(90deg, #16a34a 0%, #22c55e 45%, #7c3aed 100%);
  --shadow-card: 0 8px 24px rgba(15, 36, 25, 0.05);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg-page);
  color: var(--text-dark);
}

body.has-player {
  padding-bottom: 88px;
}

/* App Shell */
.app-shell {
  display: grid;
  grid-template-columns: 272px 1fr;
  min-height: 100vh;
}

/* Left Sidebar */
.sidebar {
  background: var(--bg-surface);
  border-right: 1px solid var(--border-light);
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.brand-lockup {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-logo {
  width: 44px;
  height: 44px;
  border-radius: 13px;
  background: var(--brand-gradient);
  display: grid;
  place-items: center;
  color: #ffffff;
  font-weight: 900;
  font-size: 16px;
  box-shadow: 0 6px 16px rgba(124, 58, 237, 0.22);
  flex-shrink: 0;
}

.brand-name {
  font-size: 16px;
  font-weight: 800;
  line-height: 1.15;
}

.brand-tagline {
  font-size: 11px;
  color: var(--purple-dark);
  font-weight: 600;
}

.side-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.side-link {
  width: 100%;
  text-align: left;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-dark);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.side-link:hover {
  background: var(--bg-soft-green);
  border-color: var(--border-light);
}

.side-link.active {
  background: var(--brand-gradient);
  color: #ffffff;
}

.side-box {
  background: var(--bg-soft-green);
  border: 1px solid var(--border-light);
  border-radius: 12px;
  padding: 12px;
}

.side-box.purple-tint {
  background: var(--bg-soft-purple);
  border-color: var(--border-purple);
}

.meter-track {
  height: 8px;
  background: #d5ede0;
  border-radius: 999px;
  overflow: hidden;
  margin: 8px 0 6px;
}

.meter-fill {
  height: 100%;
  background: var(--cta-gradient);
  transition: width 0.25s ease;
}

.pill-ad {
  display: inline-block;
  background: #fef3c7;
  color: #92400e;
  border: 1px solid #fcd34d;
  font-size: 10px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 999px;
  margin-bottom: 6px;
}

/* Main Area */
.main-area {
  padding: 20px 24px;
  min-width: 0;
}

.top-header {
  background: var(--bg-surface);
  border: 1px solid var(--border-light);
  border-radius: 16px;
  padding: 14px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 16px;
  box-shadow: var(--shadow-card);
}

.top-header h1 {
  margin: 0;
  font-size: 21px;
}

.top-header p {
  margin: 3px 0 0;
  font-size: 12.5px;
  color: var(--text-muted);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Studio Mode Tabs (Songs / Speech / Visuals) */
.studio-top-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  background: var(--bg-surface);
  border: 1px solid var(--border-light);
  padding: 6px;
  border-radius: 14px;
  margin-bottom: 16px;
}

.studio-mode-btn {
  padding: 10px 14px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: var(--text-dark);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
}

.studio-mode-btn.active {
  background: var(--brand-gradient);
  color: #ffffff;
}

.sub-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.seg-group {
  display: inline-flex;
  background: var(--bg-soft-green);
  border: 1px solid var(--border-light);
  border-radius: 10px;
  padding: 3px;
}

.seg-btn {
  border: none;
  background: transparent;
  color: var(--text-dark);
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
}

.seg-btn.active {
  background: var(--green);
  color: #ffffff;
}

/* Grid & Cards */
.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.three-col {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-light);
  border-radius: 15px;
  padding: 18px;
  box-shadow: var(--shadow-card);
}

.card h2,
.card h3 {
  margin: 0 0 8px;
}

/* Form Controls */
.field {
  margin-bottom: 13px;
}

.field label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 5px;
}

input[type="text"],
input[type="email"],
input[type="tel"],
select,
textarea {
  width: 100%;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid #c7ddd0;
  background: #ffffff;
  color: var(--text-dark);
  font-size: 14px;
  font-family: inherit;
}

input:focus,
select:focus,
textarea:focus {
  outline: 2px solid rgba(22, 163, 74, 0.25);
  border-color: var(--green);
}

input[type="range"] {
  width: 100%;
  accent-color: var(--purple);
}

.attach-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 14px;
}

.attach-btn {
  padding: 9px 10px;
  border-radius: 10px;
  border: 1px dashed var(--purple);
  background: var(--bg-soft-purple);
  color: var(--purple-dark);
  font-weight: 700;
  font-size: 12.5px;
  cursor: pointer;
}

.tag-chips {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.style-tag {
  border: 1px solid var(--border-light);
  background: var(--bg-soft-green);
  color: var(--green-dark);
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.style-tag.active {
  background: var(--purple);
  color: #ffffff;
  border-color: var(--purple);
}

/* Accordion / More Options */
.accordion-box {
  border: 1px solid var(--border-purple);
  background: #fcfaff;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 14px;
}

.option-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid #efe8ff;
}

.option-row:last-child {
  border-bottom: none;
}

/* Buttons & Badges */
.btn-primary-grad {
  width: 100%;
  padding: 12px 16px;
  border: none;
  border-radius: 12px;
  background: var(--cta-gradient);
  color: #ffffff;
  font-weight: 800;
  font-size: 14.5px;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(22, 163, 74, 0.22);
}

.btn-green {
  padding: 8px 13px;
  border: none;
  border-radius: 9px;
  background: var(--green);
  color: #ffffff;
  font-weight: 700;
  font-size: 12.5px;
  cursor: pointer;
}

.btn-purple {
  padding: 8px 13px;
  border: none;
  border-radius: 9px;
  background: var(--purple);
  color: #ffffff;
  font-weight: 700;
  font-size: 12.5px;
  cursor: pointer;
}

.btn-soft {
  padding: 8px 13px;
  border: 1px solid var(--border-light);
  border-radius: 9px;
  background: var(--bg-soft-green);
  color: var(--text-dark);
  font-weight: 700;
  font-size: 12.5px;
  cursor: pointer;
}

.badge-green {
  background: #dcfce7;
  color: #166534;
  border: 1px solid #86efac;
  padding: 5px 11px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.badge-purple {
  background: #ede9fe;
  color: #5b21b6;
  border: 1px solid #c4b5fd;
  padding: 5px 11px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

/* Track Cards & Library */
.track-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 12px 14px;
  border-radius: 12px;
  background: #f8fcf9;
  border: 1px solid var(--border-light);
}

.track-thumb {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  background: var(--brand-gradient);
  display: grid;
  place-items: center;
  color: #ffffff;
  font-weight: 800;
  font-size: 13px;
  flex-shrink: 0;
}

/* Panels & Views */
.view-section {
  display: none;
}

.view-section.active {
  display: block;
}

.sub-mode-panel {
  display: none;
}

.sub-mode-panel.active {
  display: block;
}

.alert-bar {
  display: none;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  background: #fffbeb;
  border: 1px solid #fcd34d;
  color: #78350f;
  padding: 12px 15px;
  border-radius: 12px;
  margin-bottom: 14px;
  font-size: 13px;
}

.alert-bar.show {
  display: flex;
}

.muted {
  color: var(--text-muted);
  font-size: 12.5px;
}

.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.flex-gap { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.between { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }

/* Bottom Audio Player */
.bottom-player {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-surface);
  border-top: 2px solid var(--green);
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  z-index: 40;
  box-shadow: 0 -6px 20px rgba(15, 36, 25, 0.06);
}

.player-seek-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  max-width: 520px;
}

@media (max-width: 900px) {
  .app-shell { grid-template-columns: 1fr; }
  .two-col, .three-col { grid-template-columns: 1fr; }
  .bottom-player { flex-direction: column; align-items: stretch; }
}
